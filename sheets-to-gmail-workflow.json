    {
      "parameters": {
        "jsCode": "// Ignore empty rows (rows with no name)\nconst rows = $input.all().filter(item => item.json.name);\n\n// If there is no data, flag it and stop building the email\nif (rows.length === 0) {\n  return [{ json: { hasData: false, subject: '', body: '' } }];\n}\n\nconst lines = rows.map((item, i) => {\n  const r = item.json;\n  return `${i + 1}. Name: ${r.name} | Course: ${r.course} | Status: ${r.status}`;\n});\n\nconst subject = `Data Summary from Google Sheet (${rows.length} records)`;\n\nconst body = `Hi,\n\nHere is the latest data from the sheet:\n\n${lines.join('\\n')}\n\nRegards,\nYour Automation Bot`;\n\nreturn [{ json: { hasData: true, subject, body } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
